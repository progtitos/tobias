
# ---------------------------------------------------------------------------
# Copy this file to .env for local dev, and set the same keys in Vercel's
# Environment Variables UI for production. Never commit the real .env file.
# ---------------------------------------------------------------------------

# Database — Postgres connection strings.
# Local dev: any local Postgres works.
# Production: use Supabase's "Connection string" page —
#   DATABASE_URL  = the "Transaction pooler" string (port 6543, for the app's
#                   normal request-time queries; serverless-friendly)
#   DIRECT_URL    = the "Direct connection" string (port 5432, used only for
#                   running migrations, which need a non-pooled connection)
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/tobias"
DIRECT_URL="postgresql://postgres:postgres@localhost:5432/tobias"

# Session cookie signing secret — generate with `openssl rand -base64 32`
AUTH_SECRET=""

# Supabase Storage (receipt photos). Leave empty for local dev — StorageService
# falls back to writing to local disk, which is fine on your machine but is
# NOT viable on Vercel (ephemeral filesystem), so these are required in
# production. Find them in Supabase → Project Settings → API.
SUPABASE_URL=""
SUPABASE_SERVICE_ROLE_KEY=""

# AI provider (Google Gemini). Comma-separate multiple keys to spread rate
# limits across them — AIService rotates automatically on 429s.
GEMINI_API_KEYS=""
GEMINI_TEXT_MODEL="gemini-2.0-flash"
GEMINI_VISION_MODEL="gemini-2.0-flash"

# WhatsApp Business API (Meta Cloud API) — leave empty; WhatsAppService
# no-ops and logs instead of sending when these are unset.
#   WHATSAPP_API_TOKEN        — access token for your Meta app/WhatsApp
#                               Business Account. A temporary token from the
#                               Meta App Dashboard works for testing; for
#                               production, generate a permanent token via a
#                               System User (Meta Business Settings > System
#                               Users > Generate New Token, with the
#                               whatsapp_business_messaging permission).
#   WHATSAPP_PHONE_NUMBER_ID  — found in Meta App Dashboard > WhatsApp >
#                               API Setup, under "From" (the sending number).
#   WHATSAPP_VERIFY_TOKEN     — any string you make up yourself. You type the
#                               same value into Meta's webhook configuration
#                               (App Dashboard > WhatsApp > Configuration >
#                               Webhook > Verify token) — Meta sends it back
#                               on the verification handshake, and this app
#                               checks it matches before accepting the
#                               subscription.
#   WHATSAPP_GRAPH_API_VERSION — optional, defaults to "v24.0". Meta retires
#                               old Graph API versions over time; bump this
#                               if calls start failing with a deprecation
#                               error.
WHATSAPP_API_TOKEN=""
WHATSAPP_PHONE_NUMBER_ID=""
WHATSAPP_VERIFY_TOKEN=""
WHATSAPP_GRAPH_API_VERSION=""

# Mercado Pago (Assinaturas / preapproval) — required for signup to work,
# since the card step happens during the request. Get these in your Mercado
# Pago account under Seu negócio > Configurações > Credenciais.
#   MERCADOPAGO_ACCESS_TOKEN     — secret, server-side only. Never expose to
#                                  the browser or commit it.
#   MERCADOPAGO_PUBLIC_KEY       — safe to expose client-side, unused for the
#                                  hosted-checkout flow today but kept here so
#                                  it's in one place if a Brick UI is added later.
#   MERCADOPAGO_WEBHOOK_SECRET   — from the same Credenciais page, "Chave
#                                  secreta" for the webhook you register at
#                                  <APP_URL>/api/mercadopago/webhook. Required
#                                  for the webhook to accept notifications —
#                                  without it, /api/mercadopago/webhook
#                                  rejects everything (fails closed).
# Use the APP_USR- prefixed (production) keys once you're ready to charge for
# real; Mercado Pago no longer has a separate sandbox host, so testing with
# TEST- credentials still hits mercadopago.com but never moves real money.
MERCADOPAGO_ACCESS_TOKEN=""
MERCADOPAGO_PUBLIC_KEY=""
MERCADOPAGO_WEBHOOK_SECRET=""

# App
APP_TRIAL_DAYS="15"
APP_URL="http://localhost:3000"
