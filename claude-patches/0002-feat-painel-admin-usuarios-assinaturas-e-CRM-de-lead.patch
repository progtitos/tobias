+                </div>
+              ))}
+            </div>
+          </CardContent>
+        </Card>
+        <Card>
+          <CardContent className="py-4">
+            <h2 className="font-sans font-semibold text-onbrand mb-3">Por plano</h2>
+            <div className="divide-y divide-white/[0.04]">
